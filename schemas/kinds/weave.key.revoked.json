{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inceptless.com/hyphaweave/schemas/v1/kinds/weave.key.revoked.json",
  "title": "weave.key.revoked record",
  "description": "Registered kind weave.key.revoked: announce key revocation and its effective time. Stage must be accepted. Semantic rules that JSON Schema cannot express (effective_at <= recorded_at, signer classes per reason) are verifier rules listed in schemas/README.md.",
  "allOf": [
    {
      "$ref": "../envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "weave.key.revoked"
        },
        "stage": {
          "const": "accepted"
        },
        "body": {
          "type": "object",
          "additionalProperties": true,
          "required": ["effective_at", "key", "reason"],
          "properties": {
            "effective_at": {
              "$ref": "../manifest.json#/$defs/timestamp"
            },
            "key": {
              "$ref": "../manifest.json#/$defs/key_id"
            },
            "reason": {
              "enum": ["key-compromise", "retired", "other"]
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
