{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inceptless.com/hyphaweave/schemas/v1/kinds/weave.key.declared.json",
  "title": "weave.key.declared record",
  "description": "Registered kind weave.key.declared (CONTRACT 7.1; DECISIONS E5). Stage must be accepted. Cross-field rules that JSON Schema cannot express (actor.type equals body.key_type, declared key id derivation from public_key, self-signature, valid_from <= valid_until) are verifier rules listed in schemas/README.md.",
  "allOf": [
    {
      "$ref": "../envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "weave.key.declared"
        },
        "stage": {
          "const": "accepted"
        },
        "body": {
          "type": "object",
          "additionalProperties": true,
          "required": ["algorithm", "key", "key_type", "public_key"],
          "properties": {
            "algorithm": {
              "const": "ed25519"
            },
            "key": {
              "$ref": "../manifest.json#/$defs/key_id"
            },
            "key_type": {
              "enum": ["human", "agent", "program", "device", "organization"]
            },
            "public_key": {
              "$ref": "../manifest.json#/$defs/public_key"
            },
            "valid_from": {
              "$ref": "../manifest.json#/$defs/timestamp"
            },
            "valid_until": {
              "$ref": "../manifest.json#/$defs/timestamp"
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
