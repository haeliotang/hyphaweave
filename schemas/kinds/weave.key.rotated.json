{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inceptless.com/hyphaweave/schemas/v1/kinds/weave.key.rotated.json",
  "title": "weave.key.rotated record",
  "description": "Registered kind weave.key.rotated (CONTRACT 7.2; DECISIONS E5). Stage must be accepted. Cross-field rules that JSON Schema cannot express (old_key != new_key, public keys match their ids, actor.key is the old key, signatures by both keys) are verifier rules listed in schemas/README.md.",
  "allOf": [
    {
      "$ref": "../envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "weave.key.rotated"
        },
        "stage": {
          "const": "accepted"
        },
        "body": {
          "type": "object",
          "additionalProperties": true,
          "required": ["new_key", "new_public_key", "old_key"],
          "properties": {
            "new_key": {
              "$ref": "../manifest.json#/$defs/key_id"
            },
            "new_public_key": {
              "$ref": "../manifest.json#/$defs/public_key"
            },
            "old_key": {
              "$ref": "../manifest.json#/$defs/key_id"
            },
            "old_public_key": {
              "$ref": "../manifest.json#/$defs/public_key"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
