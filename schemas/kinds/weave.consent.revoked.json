{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inceptless.com/hyphaweave/schemas/v1/kinds/weave.consent.revoked.json",
  "title": "weave.consent.revoked record",
  "description": "Registered kind weave.consent.revoked: revoke a consent record. Stage must be accepted and the actor must be a human or organization. The revokes target must resolve to a weave.consent.granted record; that is a verifier rule.",
  "allOf": [
    {
      "$ref": "../envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "weave.consent.revoked"
        },
        "stage": {
          "const": "accepted"
        },
        "actor": {
          "properties": {
            "type": {
              "enum": ["human", "organization"]
            }
          }
        },
        "body": {
          "type": "object",
          "additionalProperties": true,
          "required": ["revokes", "effective_at", "reason"],
          "properties": {
            "revokes": {
              "$ref": "../ref.json"
            },
            "effective_at": {
              "$ref": "../manifest.json#/$defs/timestamp"
            },
            "reason": {
              "type": ["string", "null"]
            }
          }
        }
      }
    }
  ]
}
